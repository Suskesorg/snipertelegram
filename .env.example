# =====================================================================
#  KONFIGURASI SNIPER BOT PANCAKESWAP
# ---------------------------------------------------------------------
#  Cara pakai:
#    1. Salin file ini:   cp .env.example .env
#    2. Buka file .env, isi semua baris yang tertulis ISI_SENDIRI
#    3. File .env TIDAK PERNAH masuk git (sudah dikunci di .gitignore)
#
#  Aturan menulis angka:
#    - Pakai TITIK untuk desimal.  Benar: 0.05    Salah: 0,05
#    - Jangan pakai pemisah ribuan. Benar: 1000   Salah: 1.000
#    - Jangan pakai tanda kutip.
# =====================================================================


# ---------------------------------------------------------------------
# 1. SAKLAR KESELAMATAN
# ---------------------------------------------------------------------
# true  = MODE SIMULASI. Bot menghitung semuanya tapi TIDAK mengirim
#         transaksi apa pun. Tidak ada uang keluar.
# false = UANG SUNGGUHAN.
#
# Kalau baris ini hilang atau isinya aneh, bot otomatis pakai true.
# Hanya Anda sendiri yang boleh mengubah ini jadi false.
DRY_RUN=true


# ---------------------------------------------------------------------
# 2. JARINGAN
# ---------------------------------------------------------------------
# 56 = BNB Smart Chain. Bot ini menolak jalan di chain lain.
CHAIN_ID=56

# RPC untuk MEMBACA data (harga, saldo, simulasi). Boleh RPC publik,
# tapi RPC berbayar jauh lebih cepat dan tidak kena rate limit.
RPC_READ_URL=ISI_SENDIRI

# RPC PRIVAT untuk MENGIRIM transaksi, supaya tidak kena sandwich attack.
#
# Pilihan A - bloXroute BSC Protect RPC (gratis, tanpa pendaftaran):
#   https://bsc.rpc.blxrbdn.com
#   Sumber: https://docs.bloxroute.com/bsc-and-eth/protect-rpcs/bsc-protect-rpc
#
# Pilihan B - 48Club Privacy RPC:
#   Alamat endpoint-nya HARUS Anda ambil sendiri dari halaman resmi
#   https://docs.48.club/privacy-rpc  (saya tidak menuliskannya dari ingatan).
#
# Kita akan uji endpoint ini bersama-sama di tahap M3.
RPC_PRIVATE_URL=ISI_SENDIRI


# ---------------------------------------------------------------------
# 3. ALAMAT KONTRAK PANCAKESWAP
# ---------------------------------------------------------------------
# CATATAN VERIFIKASI (penting, tolong dicek sendiri):
#   Halaman developer.pancakeswap.finance dan bscscan.com TIDAK BISA saya
#   buka dari lingkungan kerja saya (diblokir proxy jaringan). Alamat di
#   bawah ini saya ambil dari hasil pencarian yang mengutip judul halaman
#   resmi BscScan dan dokumentasi PancakeSwap, BUKAN dari ingatan saya.
#
#   Sebelum DRY_RUN=false, buka sendiri tiga link ini dan cocokkan hurufnya:
#     https://developer.pancakeswap.finance/contracts/v2/addresses
#     https://bscscan.com/address/0x10ED43C718714eb63d5aA57B78B54704E256024E
#     https://bscscan.com/address/0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
#   Yang benar: label BscScan tertulis "PancakeSwap: Router v2" dan
#   "PancakeSwap: Factory v2", dan kontraknya berstatus Verified.

# PancakeSwap Router v2 - label BscScan "PancakeSwap: Router v2"
PANCAKE_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E

# PancakeSwap Factory v2 - label BscScan "PancakeSwap: Factory v2"
PANCAKE_FACTORY_ADDRESS=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73

# WBNB (Wrapped BNB) di BNB Smart Chain
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c


# ---------------------------------------------------------------------
# 4. DOMPET
# ---------------------------------------------------------------------
# Private key dompet yang dipakai bot.
#
#  - Dalam mode DRY_RUN=true baris ini BOLEH dikosongkan.
#  - Isi hanya kalau Anda sudah siap pakai uang sungguhan.
#  - Pakai dompet KHUSUS bot, jangan dompet utama Anda.
#  - Nilai ini tidak pernah ditulis ke log atau dikirim ke Telegram.
PRIVATE_KEY=


# ---------------------------------------------------------------------
# 5. ANGKA-ANGKA UANG  (semua wajib diisi, tidak ada nilai bawaan)
# ---------------------------------------------------------------------
# Berapa BNB dibelanjakan untuk setiap call.
BUY_AMOUNT_BNB=0.03

# Maksimum posisi yang MODALNYA MASIH TERPASANG. Call baru diabaikan
# selama angka ini penuh.
#
# Yang dihitung hanya posisi yang modal awalnya belum ditarik. Begitu
# sebuah posisi mencapai 3x dan modal awal sudah kembali ke dompet,
# posisi itu jadi bebas risiko dan TIDAK lagi memakan kuota, walaupun
# sisa tokennya masih Anda pegang.
#
# Jadi angka ini berarti: "maksimal sekian x BUY_AMOUNT_BNB yang boleh
# sedang berisiko pada satu waktu".
MAX_OPEN_POSITIONS=10

# Batas rugi per hari, dalam BNB.
#
# ANGKA 0 BERARTI TANPA BATAS. Bukan "berhenti begitu rugi 0 BNB".
# Ini pilihan sadar Anda: strateginya menebar benih ke semua alert, jadi
# rem harian dimatikan.
#
# Kalau suatu saat ingin mengaktifkan, isi angka lebih besar dari 0.
# Saat aktif: bot berhenti MEMBELI sampai lewat tengah malam UTC.
# Menjual tetap jalan apa pun keadaannya.
MAX_DAILY_LOSS_BNB=0

# Batas atas gas price dalam gwei. Percobaan ulang menaikkan gas, tapi
# tidak pernah melewati batas ini.
MAX_GAS_PRICE_GWEI=ISI_SENDIRI

# Toleransi selisih harga saat beli, dalam persen.
#
# Angka ini HANYA untuk pergerakan harga, bukan untuk pajak token.
# Pajak token diukur terpisah lewat simulasi jual di tahap M3, lalu
# dikurangkan lebih dulu sebelum angka slippage ini dipakai. Kalau tidak
# begitu, token berpajak 10% akan selalu gagal beli/jual pada slippage 10%.
BUY_SLIPPAGE_PERCENT=10

# Toleransi selisih harga saat jual, dalam persen.
#
# CATATAN RISIKO (pilihan Anda, saya hormati, tapi wajib saya tulis):
# 10% itu ketat untuk penjualan. Trailing stop selalu menembak persis saat
# harga sedang jatuh cepat dan banyak orang menjual bersamaan, dan di saat
# seperti itu harga sering bergerak lebih dari 10% di antara bot menghitung
# dan transaksi masuk blok. Akibatnya penjualan bisa revert, padahal Anda
# sendiri menyebut jual yang gagal sebagai kegagalan paling fatal.
#
# Pengaman yang kita punya untuk menutupi ini:
#   - percobaan ulang otomatis dengan gas lebih tinggi (M3)
#   - pajak token diukur dulu, jadi tidak memakan jatah 10% ini
# Kalau di tahap M4 nanti terlihat sering revert, kita naikkan angka ini.
SELL_SLIPPAGE_PERCENT=10

# Kelipatan modal untuk menarik modal awal. Contoh 3 berarti: saat nilai
# posisi mencapai 3x modal, jual porsi secukupnya sampai BNB yang benar-benar
# masuk dompet sama dengan modal awal.
TAKE_PROFIT_MULTIPLIER=3

# Trailing stop untuk sisa posisi. Contoh 70 berarti: jual habis kalau
# harga turun 70% dari harga tertinggi yang pernah tercapai.
TRAILING_STOP_PERCENT=70

# Saldo BNB yang selalu disisakan di dompet untuk membayar gas saat menjual.
# Bot menolak membeli kalau pembelian akan membuat saldo turun di bawah ini.
GAS_RESERVE_BNB=0.05


# ---------------------------------------------------------------------
# 6. TELEGRAM - PENDENGAR (akun pribadi Anda / userbot)
# ---------------------------------------------------------------------
# Ambil dari https://my.telegram.org -> API development tools
# Diisi nanti di tahap M2.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=sniper_listener

# Id channel yang dipantau, pisahkan dengan koma. Id channel biasanya
# angka negatif panjang, contoh: -1001234567890
# Nanti ada perintah bantu untuk mencari id ini di tahap M2.
WATCH_CHAT_IDS=


# ---------------------------------------------------------------------
# 7. TELEGRAM - KONTROL MANUAL (bot pribadi dari BotFather)
# ---------------------------------------------------------------------
# Diisi nanti di tahap M5.
CONTROL_BOT_TOKEN=

# Chat id Anda sendiri. Bot menolak perintah dari siapa pun selain id ini.
OWNER_CHAT_ID=


# ---------------------------------------------------------------------
# 8. TEKNIS
# ---------------------------------------------------------------------
# Batas waktu simulasi jual sebelum beli, dalam milidetik.
SELL_SIMULATION_TIMEOUT_MS=300

# Alamat yang tidak pernah dibeli walaupun muncul di channel.
# Router, Factory, dan WBNB sudah dikecualikan otomatis karena alamatnya
# ada di bagian 3 di atas. Daftar stablecoin (USDT, USDC, BUSD, CAKE)
# akan saya tambahkan di tahap M2 setelah alamatnya diverifikasi.
# Baris ini untuk tambahan dari Anda. Pisahkan dengan koma.
BLACKLIST_ADDRESSES=

# DEBUG untuk log sangat rinci, INFO untuk pemakaian normal.
LOG_LEVEL=INFO

# Lokasi database dan folder log. Biarkan saja kalau tidak yakin.
DATABASE_PATH=data/sniper.db
LOG_DIR=logs
